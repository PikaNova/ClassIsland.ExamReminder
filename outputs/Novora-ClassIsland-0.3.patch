new file mode 100644
index 0000000..ea5a83d
--- /dev/null
+++ b/api/_content/announcementCache.ts
@@ -0,0 +1,22 @@
+// Share one upstream request among callers of the same warm server instance.
+// Keep the existing 60-second freshness budget; this also works without a CDN.
+export function createAnnouncementCache(ttlMs = 60_000) {
+  let cached: { at: number; items: Record<string, unknown>[] } | null = null;
+  let flight: Promise<Record<string, unknown>[]> | null = null;
+  return async (
+    load: () => Promise<Record<string, unknown>[]>,
+    now = Date.now(),
+  ): Promise<Record<string, unknown>[]> => {
+    if (cached && now - cached.at < ttlMs) return cached.items;
+    if (flight) return flight;
+    flight = load()
+      .then((items) => {
+        cached = { at: Date.now(), items };
+        return items;
+      })
+      .finally(() => {
+        flight = null;
+      });
+    return flight;
+  };
+}
